<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Confirmation</title>
    <link rel="icon" href="/images/envelope.png">
    <link rel="stylesheet" href="styles/confirm.css">
</head>
<body>
    <header>
        <h1>Confirmed!</h1>
       <%- include ('partials/navigation') %>
    </header>
     <main>
        <div id="main">
            <h2>Contact summary</h2>
            <p>Name: <%= contact.fname %> <%= contact.lname %></p>
            <p>Job Title: <%= contact.jobtitle %></p>
            <p>Company: <%= contact.company %></p>
            <p>LinkedIn: <%= contact.linked %></p>
            <p>email: <%= contact.email %></p>
            <p>How we met: <%= contact.meeting %> <%= contact.specify %></p>
            <p>Message: <%= contact.message %></p>
        </div>
    </main>
</body>
</html>